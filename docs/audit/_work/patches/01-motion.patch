+/* ── Reduced motion — the ONE place it is handled ───────────────────────────
+ * Every transition and animation in the package reads its duration from the
+ * motion scale, so collapsing the scale here makes the whole system instant.
+ * No component carries a reduce override that only shortens a duration.
+ *
+ * 1ms, NOT 0ms, and that is load-bearing: a 0ms transition never fires
+ * `transitionrun` or `transitionend`, and several components hang real work
+ * off those events (RevealChangeText swaps its content and calls `onSettled`
+ * on `transitionend`; MorphRotationShape starts sampling on `transitionrun`).
+ * At 0ms they would strand content on screen. 1ms reads as instant and still
+ * fires every event.
+ *
+ * Staggers go to zero so nothing waits on a delay. Loop cycle times
+ * (--ui-shimmer-duration, --ui-shape-morph-*) are deliberately absent: a loop
+ * at 1ms would strobe, so each loop's own reduce rule stops it or shows a
+ * static frame instead.
+ *
+ * `.light` is listed beside `:root` because it redeclares the scale; without
+ * it a `.light` subtree would quietly restore full-length motion. */
+@media (prefers-reduced-motion: reduce) {
+  :root,
+  .light {
+    --ui-motion-duration-fast: 1ms;
+    --ui-motion-duration-base: 1ms;
+    --ui-motion-duration-slow: 1ms;
+    --ui-motion-duration-slower: 1ms;
+    --ui-motion-duration-slowest: 1ms;
+    --ui-roll-hover-stagger: 0ms;
+    --ui-rolling-digits-stagger: 0ms;
+  }
+}
