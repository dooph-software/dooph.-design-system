+   * --ui-shape-morph-nudge, which it follows by default); 0 = no lean. */
+  --ui-caret-nudge: var(--ui-shape-morph-nudge); /* expression */
+}
+
+} /* @layer ds.tokens */
+
+/* ── Expression presets ─────────────────────────────────────────────────────
+ * A product-level setting: put the attribute on the root element —
+ * `<html data-ds-expression="practical">` in a Next.js app/layout.tsx, or
+ * index.html in Vite. Nesting works ("nearest ancestor wins") but is
+ * discouraged. Every expression-marked token above MUST appear here with
+ * its neutral value. A product's own unlayered tokens.css still beats this. */
+@layer ds.expression {
+  [data-ds-expression="practical"] {
+    --ui-caret-shape-scale: 0;
+    --ui-caret-nudge: 0;
   }
 }
