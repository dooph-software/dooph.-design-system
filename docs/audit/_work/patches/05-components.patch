index 0000000..295bcef
--- /dev/null
+++ b/src/components/Toggle/FancyToggleSwitch.tsx
@@ -0,0 +1,200 @@
+"use client";
+
+/*
+ * FancyToggleSwitch / FancyToggleSwitchItem — Figma Toggle Switch `Fancy`
+ * (826:2149) built from Toggle Option `Fancy` / `Fancy+Icon` (826:1723).
+ * A dedicated row, separate from ToggleSwitch by maintainer decision
+ * (2026-10-03) so ToggleSwitch's 4px gap and toggleOption's shared unselected
+ * look stay true. Option styling lives in ./fancyToggleOption.
+ *
+ * ## behavior
+ * - Radix ToggleGroup wiring, like ToggleSwitch. Options sit 12px apart (md).
+ * - `selectType` single (default): `value` is a string and selection can never
+ *   be cleared — Radix's "" on a second click is dropped, exactly as in
+ *   ToggleSwitch. Controlled (`value` + `onValueChange`) and uncontrolled
+ *   (`defaultValue`) both work; a controlled `value` always wins.
+ * - `selectType` multi: `value` is a string[]; any number of options,
+ *   including none. Radix owns the uncontrolled state.
+ * - Items read `selectType` from context (single: the chosen option gets the
+ *   default cursor). An item `icon` switches its indicator from the
+ *   stroke-only ring + DS check to a filled circle holding that icon.
+ *
+ * ## constraints
+ * - Single mode keeps Radix fully controlled — passing `defaultValue` through
+ *   would let Radix's own state clear itself regardless of the callback (the
+ *   same constraint as Toggle.tsx). If ToggleSwitch's never-clear rule
+ *   changes, change this one with it; they must not drift.
+ * - The single-mode useState sits above the mode branch so the hook order
+ *   never depends on `selectType`.
+ */
+
+import * as ToggleGroup from "@radix-ui/react-toggle-group";
+import {
+  createContext,
+  forwardRef,
+  useContext,
+  useState,
+  type ComponentPropsWithoutRef,
+  type ComponentRef,
+  type ReactNode,
+} from "react";
+import { cn } from "../../utils/cn";
+import { CheckIcon } from "../Icons/CheckIcon";
+import { FancyToggleSelectType } from "./constants";
+import {
+  fancyToggleCheckClass,
+  fancyToggleIndicatorSlot,
+  fancyToggleIndicatorVariants,
+  fancyToggleOptionVariants,
+} from "./fancyToggleOption";
+
+const FancyTogglePresentationContext = createContext<{
+  selectType: FancyToggleSelectType;
+}>({ selectType: FancyToggleSelectType.single });
+
+/** Stable context values, one per mode, so items don't re-render on every root render. */
+const PRESENTATION: Record<
+  FancyToggleSelectType,
+  { selectType: FancyToggleSelectType }
+> = {
+  single: { selectType: FancyToggleSelectType.single },
+  multi: { selectType: FancyToggleSelectType.multi },
+};
+
+// Figma Fancy Toggle Switch: md (12px) between options.
+const ROOT_CLASS = "inline-flex items-center gap-md";
+
+type FancyToggleSwitchRootProps = Omit<
+  ComponentPropsWithoutRef<typeof ToggleGroup.Root>,
+  "type" | "value" | "onValueChange" | "defaultValue"
+>;
+
+export type FancyToggleSwitchProps =
+  | (FancyToggleSwitchRootProps & {
+      /** Default single: exactly one option, never cleared. */
+      selectType?: typeof FancyToggleSelectType.single;
+      value?: string;
+      defaultValue?: string;
+      /** Never called with "" — the selected option cannot be toggled off. */
+      onValueChange?: (value: string) => void;
+    })
+  | (FancyToggleSwitchRootProps & {
+      selectType: typeof FancyToggleSelectType.multi;
+      value?: string[];
+      defaultValue?: string[];
+      onValueChange?: (value: string[]) => void;
+    });
+
+const FancyToggleSwitch = forwardRef<
+  ComponentRef<typeof ToggleGroup.Root>,
+  FancyToggleSwitchProps
+>((props, ref) => {
+  const [uncontrolledValue, setUncontrolledValue] = useState(
+    props.selectType === FancyToggleSelectType.multi
+      ? ""
+      : (props.defaultValue ?? ""),
+  );
+
+  if (props.selectType === FancyToggleSelectType.multi) {
+    const {
+      selectType,
+      className,
+      value,
+      defaultValue,
+      onValueChange,
+      children,
+      ...rest
+    } = props;
+    return (
+      <FancyTogglePresentationContext.Provider value={PRESENTATION[selectType]}>
+        <ToggleGroup.Root
+          ref={ref}
+          type="multiple"
+          value={value}
+          defaultValue={defaultValue}
+          onValueChange={onValueChange}
+          className={cn(ROOT_CLASS, className)}
+          {...rest}
+        >
+          {children}
+        </ToggleGroup.Root>
+      </FancyTogglePresentationContext.Provider>
+    );
+  }
+
+  const {
+    selectType = FancyToggleSelectType.single,
+    className,
+    value,
+    defaultValue: _defaultValue,
+    onValueChange,
+    children,
+    ...rest
+  } = props;
+  const isControlled = value !== undefined;
+  const currentValue = isControlled ? value : uncontrolledValue;
+
+  const handleValueChange = (next: string) => {
+    // Radix reports "" when the active item is clicked again — ignore it.
+    if (next === "") return;
+    if (!isControlled) setUncontrolledValue(next);
+    onValueChange?.(next);
+  };
+
+  return (
+    <FancyTogglePresentationContext.Provider value={PRESENTATION[selectType]}>
+      <ToggleGroup.Root
+        ref={ref}
+        type="single"
+        value={currentValue}
+        onValueChange={handleValueChange}
+        className={cn(ROOT_CLASS, className)}
+        {...rest}
