+import {
+  forwardRef,
+  type ComponentPropsWithoutRef,
+  type ReactNode,
+} from "react";
+import { cn } from "../../utils/cn";
+import { Checkbox } from "../Checkbox/Checkbox";
+import { BodyText, LabelText } from "../Text";
+
+export interface CheckboxFieldProps
+  extends ComponentPropsWithoutRef<typeof Checkbox> {
+  /** Text label rendered beside the checkbox. */
+  label: ReactNode;
+  /** Optional hint text rendered below the label in a secondary colour. */
+  hint?: ReactNode;
+}
+
+/** A checkbox with a label beside it and an optional hint line below the label.
+ * `className`, `style` and `ref` land on the wrapping `<label>`. Every other
+ * prop (including `checked`, `onCheckedChange`, `variant` and `disabled`)
+ * forwards to the inner `Checkbox`. */
+const CheckboxField = forwardRef<HTMLLabelElement, CheckboxFieldProps>(
+  ({ label, hint, className, style, variant, disabled, ...checkboxProps }, ref) => (
+    <LabelText
+      ref={ref}
+      as="label"
+      className={cn(
+        "flex items-start gap-sm",
+        disabled && "ds-disabled-state",
+        className,
+      )}
+      style={style}
+    >
+      <Checkbox
+        variant={variant}
+        disabled={disabled}
+        // pt-xxxs aligns the checkbox centre with the label text centre:
+        // label line-height is ~20 px, checkbox is 16 px, (20 - 16) / 2 = 2 px = xxxs.
+        className="mt-xxxs shrink-0"
+        {...checkboxProps}
+      />
+      <span className="flex min-w-0 flex-col gap-xxs">
+        <span>{label}</span>
+        {hint != null && (
+          <BodyText className="text-text-secondary">{hint}</BodyText>
+        )}
+      </span>
+    </LabelText>
+  ),
+);
+CheckboxField.displayName = "CheckboxField";
+
+export { CheckboxField };
