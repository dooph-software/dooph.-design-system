+/* Collapsible content — slide height from 0 to the Radix-measured value and
+ * back. Radix sets --radix-collapsible-content-height on the content element
+ * before mounting/unmounting. Keyframes, not transitions, because Presence
+ * unmounts on animationend (transitions are ignored). Fade is handled
+ * separately by animate-in / animate-out on the same element. */
+@keyframes ds-collapsible-open {
+  from {
+    height: 0;
+  }
+  to {
+    height: var(--radix-collapsible-content-height);
+  }
+}
+@keyframes ds-collapsible-close {
+  from {
+    height: var(--radix-collapsible-content-height);
+  }
+  to {
+    height: 0;
+  }
+}
+
 /* UnderlineLinkText sweep. First half: hold the right edge and shrink to zero so
