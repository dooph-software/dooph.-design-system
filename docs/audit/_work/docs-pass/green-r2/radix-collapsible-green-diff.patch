+import { useState } from "react";
+import type { Meta, StoryObj } from "@storybook/react-vite";
+import { BodyText } from "../Text";
+import {
+  Collapsible,
+  CollapsibleContent,
+  CollapsibleTrigger,
+} from "./Collapsible";
+
+const meta: Meta<typeof Collapsible> = {
+  title: "Bits & Pieces/Collapsible",
+  component: Collapsible,
+  parameters: { layout: "centered" },
+};
+export default meta;
+
+type Story = StoryObj<typeof Collapsible>;
+
+export const Default: Story = {
+  render: () => (
+    <Collapsible className="flex w-72 flex-col gap-sm">
+      <CollapsibleTrigger>More details</CollapsibleTrigger>
+      <CollapsibleContent>
+        <BodyText className="text-text-secondary">
+          Here is some additional content that was hidden. It slides open and
+          closed with an animation.
+        </BodyText>
+      </CollapsibleContent>
+    </Collapsible>
+  ),
+};
+
+export const DefaultOpen: Story = {
+  render: () => (
+    <Collapsible defaultOpen className="flex w-72 flex-col gap-sm">
+      <CollapsibleTrigger>Collapse me</CollapsibleTrigger>
+      <CollapsibleContent>
+        <BodyText className="text-text-secondary">
+          This section starts open. Click the trigger to collapse it.
+        </BodyText>
+      </CollapsibleContent>
+    </Collapsible>
+  ),
+};
+
+export const Disabled: Story = {
+  render: () => (
+    <Collapsible disabled className="flex w-72 flex-col gap-sm">
+      <CollapsibleTrigger>Cannot expand</CollapsibleTrigger>
+      <CollapsibleContent>
+        <BodyText className="text-text-secondary">
+          This content is never visible because the collapsible is disabled.
+        </BodyText>
+      </CollapsibleContent>
+    </Collapsible>
+  ),
+};
+
+/** A controlled collapsible where the parent owns the open state. */
+export const Controlled: Story = {
+  render: function ControlledStory() {
+    const [open, setOpen] = useState(false);
+
+    return (
+      <Collapsible
+        open={open}
+        onOpenChange={setOpen}
+        className="flex w-72 flex-col gap-sm"
+      >
+        <CollapsibleTrigger>
+          {open ? "Hide settings" : "Show settings"}
+        </CollapsibleTrigger>
+        <CollapsibleContent>
+          <BodyText className="text-text-secondary">
+            The parent controls whether this is open. Current state:{" "}
+            {open ? "open" : "closed"}.
+          </BodyText>
+        </CollapsibleContent>
+      </Collapsible>
+    );
+  },
+};
