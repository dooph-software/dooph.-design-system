+// Server-safe constants — no client APIs, intentionally NO "use client" directive
+// so these dot-accessible enums can be read from React Server Components.
+
+/**
+ * Dot-accessible service-status values.
+ * Usage: <ServiceStatusBadge status={ServiceStatusBadgeStatus.operational} />
+ */
+export const ServiceStatusBadgeStatus = {
+  operational: "operational",
+  degraded: "degraded",
+  down: "down",
+} as const;
+export type ServiceStatusBadgeStatus =
+  (typeof ServiceStatusBadgeStatus)[keyof typeof ServiceStatusBadgeStatus];
