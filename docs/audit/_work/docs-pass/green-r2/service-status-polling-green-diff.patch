+import { forwardRef, type HTMLAttributes } from "react";
+import { cn } from "../../utils/cn";
+import { ButtonText } from "../Text";
+import { Sticker } from "../Sticker";
+import { StickerSize, StickerVariant } from "../Sticker/constants";
+import { ServiceStatusBadgeStatus } from "./constants";
+
+type BuiltInVariant = Exclude<StickerVariant, typeof StickerVariant.custom>;
+
+const statusToVariant: Record<ServiceStatusBadgeStatus, BuiltInVariant> = {
+  [ServiceStatusBadgeStatus.operational]: StickerVariant.alternate,
+  [ServiceStatusBadgeStatus.degraded]: StickerVariant.prominent,
+  [ServiceStatusBadgeStatus.down]: StickerVariant.danger,
+};
+
+const defaultLabels: Record<ServiceStatusBadgeStatus, string> = {
+  [ServiceStatusBadgeStatus.operational]: "Operational",
+  [ServiceStatusBadgeStatus.degraded]: "Degraded",
+  [ServiceStatusBadgeStatus.down]: "Down",
+};
+
+/** A coloured Sticker that reflects a service's health. The consuming app owns
+ * polling and passes the current `status` as a prop. */
+export interface ServiceStatusBadgeProps
+  extends Omit<HTMLAttributes<HTMLDivElement>, "children" | "color"> {
+  /** Current service status. Maps to a Sticker variant. */
+  status: ServiceStatusBadgeStatus;
+  /** Override the default label ("Operational", "Degraded", "Down"). */
+  label?: string;
+  /** Sticker size. */
+  size?: StickerSize;
+}
+
+const ServiceStatusBadge = forwardRef<HTMLDivElement, ServiceStatusBadgeProps>(
+  ({ status, label, size, className, ...props }, ref) => (
+    <Sticker
+      ref={ref}
+      variant={statusToVariant[status]}
+      size={size}
+      className={cn(className)}
+      {...props}
+    >
+      <span
+        aria-hidden
+        className="size-xs shrink-0 rounded-full bg-current"
+      />
+      <ButtonText>{label ?? defaultLabels[status]}</ButtonText>
+    </Sticker>
+  ),
+);
+ServiceStatusBadge.displayName = "ServiceStatusBadge";
+
+export { ServiceStatusBadge };
