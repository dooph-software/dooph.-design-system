@@ -0,0 +1,103 @@
+import type { Meta, StoryObj } from "@storybook/react-vite";
+import { useState } from "react";
+import { BodyText } from "../Text";
+import {
+  Collapsible,
+  CollapsibleContent,
+  CollapsibleTrigger,
+} from "./Collapsible";
+
+const meta: Meta<typeof Collapsible> = {
+  title: "Disclosure/Collapsible",
+  component: Collapsible,
+  tags: ["autodocs"],
+};
+export default meta;
+
+type Story = StoryObj<typeof Collapsible>;
+
+export const Default: Story = {
+  render: () => (
+    <Collapsible className="w-[320px]">
+      <CollapsibleTrigger label="Show details" />
+      <CollapsibleContent>
+        <div className="pt-sm">
+          <BodyText>
+            This content is revealed when the trigger is clicked. The chevron
+            rotates to indicate the open state.
+          </BodyText>
+        </div>
+      </CollapsibleContent>
+    </Collapsible>
+  ),
+};
+
+export const DefaultOpen: Story = {
+  render: () => (
+    <Collapsible defaultOpen className="w-[320px]">
+      <CollapsibleTrigger label="Already open" />
+      <CollapsibleContent>
+        <div className="pt-sm">
+          <BodyText>This section starts expanded.</BodyText>
+        </div>
+      </CollapsibleContent>
+    </Collapsible>
+  ),
+};
+
+export const Controlled: Story = {
+  render: () => {
+    const [open, setOpen] = useState(false);
+    return (
+      <div className="flex flex-col gap-md w-[320px]">
+        <BodyText>
+          Open: <strong>{String(open)}</strong>
+        </BodyText>
+        <Collapsible open={open} onOpenChange={setOpen}>
+          <CollapsibleTrigger label="Controlled" />
+          <CollapsibleContent>
+            <div className="pt-sm">
+              <BodyText>State is managed externally.</BodyText>
+            </div>
+          </CollapsibleContent>
+        </Collapsible>
+      </div>
+    );
+  },
+};
+
+export const CustomTrigger: Story = {
+  render: () => (
+    <Collapsible className="w-[320px]">
+      <CollapsibleTrigger>
+        <span className="text-style-label text-prominent-color">
+          Custom trigger content
+        </span>
+      </CollapsibleTrigger>
+      <CollapsibleContent>
+        <div className="pt-sm">
+          <BodyText>
+            The trigger can render arbitrary children alongside the chevron.
+          </BodyText>
+        </div>
+      </CollapsibleContent>
+    </Collapsible>
+  ),
+};
+
+export const Multiple: Story = {
+  render: () => (
+    <div className="flex flex-col gap-md w-[320px]">
+      {["Section A", "Section B", "Section C"].map((section) => (
+        <Collapsible key={section}>
+          <CollapsibleTrigger label={section} />
+          <CollapsibleContent>
+            <div className="pt-sm">
+              <BodyText>Content for {section}.</BodyText>
+            </div>
+          </CollapsibleContent>
+        </Collapsible>
+      ))}
+    </div>
+  ),
+};
diff --git a/src/components/Collapsible/Collapsible.tsx b/src/components/Collapsible/Collapsible.tsx
new file mode 100644
index 0000000..db6fded
--- /dev/null
+++ b/src/components/Collapsible/Collapsible.tsx
@@ -0,0 +1,65 @@
+import * as CollapsiblePrimitive from "@radix-ui/react-collapsible";
+import {
+  forwardRef,
+  type ComponentPropsWithoutRef,
+  type ComponentRef,
+} from "react";
+import { cn } from "../../utils/cn";
+import { ChevronDownIcon } from "../Icons/ChevronDownIcon";
+import { IconSize } from "../Icons/BaseIcon";
+
+const Collapsible = CollapsiblePrimitive.Root;
+
+type CollapsibleTriggerProps = ComponentPropsWithoutRef<
+  typeof CollapsiblePrimitive.Trigger
+> & {
+  /** Text label shown next to the chevron. */
+  label?: string;
+};
+
+const CollapsibleTrigger = forwardRef<
+  ComponentRef<typeof CollapsiblePrimitive.Trigger>,
+  CollapsibleTriggerProps
+>(({ className, label, children, ...props }, ref) => (
+  <CollapsiblePrimitive.Trigger
+    ref={ref}
+    className={cn(
+      "group flex w-full cursor-pointer items-center gap-sm",
+      "text-style-label text-text",
+      "ds-motion-state",
+      "ds-focus-visible-ring rounded-tight",
+      className,
+    )}
+    {...props}
+  >
+    <ChevronDownIcon
+      size={IconSize.md}
+      className={cn(
+        "shrink-0 transition-transform",
+        "duration-[var(--ui-motion-duration-base)] ease-[var(--ui-motion-ease-standard)]",
+        "-rotate-90 group-data-[state=open]:rotate-0",
+      )}
+    />
+    {label != null ? <span>{label}</span> : null}
+    {children}
+  </CollapsiblePrimitive.Trigger>
+));
+CollapsibleTrigger.displayName = "CollapsibleTrigger";
+
+const CollapsibleContent = forwardRef<
+  ComponentRef<typeof CollapsiblePrimitive.Content>,
+  ComponentPropsWithoutRef<typeof CollapsiblePrimitive.Content>
+>(({ className, children, ...props }, ref) => (
+  <CollapsiblePrimitive.Content
+    ref={ref}
+    className={cn("ds-collapsible-content", className)}
+    forceMount
+    {...props}
+  >
+    {children}
+  </CollapsiblePrimitive.Content>
+));
+CollapsibleContent.displayName = "CollapsibleContent";
+
+export { Collapsible, CollapsibleContent, CollapsibleTrigger };
+export type { CollapsibleTriggerProps };
