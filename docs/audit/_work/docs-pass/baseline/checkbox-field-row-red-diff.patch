+/*
+ * CheckboxField — a checkbox with a label and optional hint text, laid out as
+ * a single clickable row.
+ *
+ * ## behavior
+ * - Clicking anywhere on the row (label, hint, or checkbox) toggles the
+ *   checkbox. The entire row is wrapped in a `<label>`.
+ * - When `hint` is provided, a secondary line of body text appears below the
+ *   label. The hint is linked to the checkbox via `aria-describedby`.
+ * - Disabled state dims both the checkbox and the text.
+ *
+ * ## constraints
+ * - The inner Checkbox is not independently styled — pass `variant` or
+ *   `className` through CheckboxField props; do not reach into the DOM.
+ * - `children` is reserved for the label content (ReactNode). Use `hint` for
+ *   the description line.
+ */
+import { forwardRef, useId, type ComponentRef } from "react";
+import * as CheckboxPrimitive from "@radix-ui/react-checkbox";
+import { Checkbox, type CheckboxProps } from "../Checkbox/Checkbox";
+import { BodyText, LabelText } from "../Text";
+import { cn } from "../../utils/cn";
+
+export interface CheckboxFieldProps extends CheckboxProps {
+  /** Primary label displayed next to the checkbox. */
+  label: React.ReactNode;
+  /** Optional hint text rendered below the label in a smaller, secondary style. */
+  hint?: React.ReactNode;
+}
+
+const CheckboxField = forwardRef<
+  ComponentRef<typeof CheckboxPrimitive.Root>,
+  CheckboxFieldProps
+>(({ label, hint, className, id, disabled, ...checkboxProps }, ref) => {
+  const autoId = useId();
+  const checkboxId = id ?? autoId;
+  const hintId = hint ? `${checkboxId}-hint` : undefined;
+
+  return (
+    <label
+      htmlFor={checkboxId}
+      className={cn(
+        "group/field inline-flex cursor-pointer items-start gap-2",
+        disabled && "pointer-events-none",
+        className,
+      )}
+    >
+      <Checkbox
+        ref={ref}
+        id={checkboxId}
+        disabled={disabled}
+        aria-describedby={hintId}
+        {...checkboxProps}
+      />
+      <span className="flex min-w-0 flex-col gap-0.5">
+        <LabelText
+          className={cn(
+            "cursor-pointer select-none",
+            disabled && "text-text-disabled",
+          )}
+        >
+          {label}
+        </LabelText>
+        {hint && (
+          <BodyText
+            id={hintId}
+            className={cn(
+              "text-text-secondary",
+              disabled && "text-text-disabled",
+            )}
+          >
+            {hint}
+          </BodyText>
+        )}
+      </span>
+    </label>
+  );
+});
+CheckboxField.displayName = "CheckboxField";
+
+export { CheckboxField };
