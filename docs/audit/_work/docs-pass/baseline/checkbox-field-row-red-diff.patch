+  type CheckboxChecked as CheckboxCheckedValue,
+} from '../Checkbox/constants';
+
+const meta = {
+  title: 'Inputs/CheckboxField',
+  component: CheckboxField,
+  parameters: { layout: 'centered' },
+  tags: ['autodocs'],
+  argTypes: {
+    variant: {
+      control: 'select',
+      options: Object.values(CheckboxVariant),
+    },
+  },
+} satisfies Meta<typeof CheckboxField>;
+
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+export const Default: Story = {
+  args: {
+    label: 'Enable notifications',
+  },
+};
+
+export const WithHint: Story = {
+  args: {
+    label: 'Enable notifications',
+    hint: 'Receive email alerts when someone mentions you.',
+  },
+};
+
+export const Checked: Story = {
+  args: {
+    label: 'Accept terms and conditions',
+    defaultChecked: true,
+  },
+};
+
+export const CheckedWithHint: Story = {
+  args: {
+    label: 'Dark mode',
+    hint: 'Use a darker color scheme that reduces eye strain.',
+    defaultChecked: true,
+  },
+};
+
+export const PrimaryVariant: Story = {
+  args: {
+    label: 'Remember me',
+    hint: 'Stay signed in on this device.',
+    defaultChecked: true,
+    variant: CheckboxVariant.primary,
+  },
+};
+
+export const Disabled: Story = {
+  args: {
+    label: 'Admin access',
+    hint: 'Only organization owners can enable this setting.',
+    disabled: true,
+  },
+};
+
+export const DisabledChecked: Story = {
+  args: {
+    label: 'Two-factor authentication',
+    hint: 'Required by your organization policy.',
+    disabled: true,
+    checked: CheckboxChecked.checked,
+  },
+};
+
+export const Controlled: Story = {
+  args: {
+    label: 'Send me marketing emails',
+  },
+  render: (args) => {
+    const [checked, setChecked] = useState<CheckboxCheckedValue>(
