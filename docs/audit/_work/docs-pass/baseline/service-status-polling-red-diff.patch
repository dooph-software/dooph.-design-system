+/*
+ * ServiceStatus — a live badge that polls a status endpoint and shows the
+ * result as a coloured Sticker.
+ *
+ * ## behavior
+ * - On mount and every `interval` ms (default 30 000) the component fetches
+ *   `url`, expecting `{ status: "operational" | "degraded" | "down" }`.
+ * - The response is mapped to a Sticker variant:
+ *     operational → alternate, degraded → custom #f59e0b, down → danger,
+ *     unknown (initial / error) → tertiary.
+ * - A small filled circle before the label echoes the Sticker's content colour.
+ * - The poll is cleared on unmount and restarted when `url` or `interval`
+ *   changes.
+ *
+ * ## constraints
+ * - status-no-cache: fetch must set `cache: "no-store"` so every poll hits the
+ *   origin. Serving stale data defeats the purpose of a live badge.
+ * - status-cleanup: the interval must be cleared on unmount and on dependency
+ *   change. Leaking timers causes ghost requests after the component is gone.
+ */
+import { forwardRef, useEffect, useState, type HTMLAttributes } from "react";
+import { cn } from "../../utils/cn";
+import { ButtonText } from "../Text";
+import { Sticker } from "../Sticker/Sticker";
+import { StickerVariant } from "../Sticker/constants";
+import { ServiceStatusState } from "./constants";
+
+const STATUS_COLOR_DEGRADED = "#f59e0b";
+
+function stickerPropsForStatus(status: ServiceStatusState) {
+  switch (status) {
+    case ServiceStatusState.operational:
+      return { variant: StickerVariant.alternate } as const;
+    case ServiceStatusState.degraded:
+      return {
+        variant: StickerVariant.custom,
+        color: STATUS_COLOR_DEGRADED,
+      } as const;
+    case ServiceStatusState.down:
+      return { variant: StickerVariant.danger } as const;
+    default:
+      return { variant: StickerVariant.tertiary } as const;
+  }
+}
+
+export type ServiceStatusProps = Omit<
+  HTMLAttributes<HTMLDivElement>,
+  "children" | "color"
+> & {
+  /** Endpoint URL that returns `{ status: "operational" | "degraded" | "down" }`. */
+  url: string;
+  /** Visible label shown beside the status dot. */
+  label: string;
+  /** Polling interval in milliseconds. @default 30000 */
+  interval?: number;
+};
+
+const ServiceStatus = forwardRef<HTMLDivElement, ServiceStatusProps>(
+  ({ url, label, interval = 30_000, className, ...props }, ref) => {
+    const [status, setStatus] = useState<ServiceStatusState>(
+      ServiceStatusState.unknown,
+    );
+
+    useEffect(() => {
+      let active = true;
+
+      async function poll() {
+        try {
+          const res = await fetch(url, { cache: "no-store" });
+          const json = (await res.json()) as { status?: string };
+          if (!active) return;
+
+          const value = json.status;
+          if (
+            value === ServiceStatusState.operational ||
+            value === ServiceStatusState.degraded ||
+            value === ServiceStatusState.down
+          ) {
+            setStatus(value);
+          } else {
+            setStatus(ServiceStatusState.unknown);
+          }
+        } catch {
+          if (active) setStatus(ServiceStatusState.unknown);
+        }
+      }
+
+      poll();
+      const id = setInterval(poll, interval);
+      return () => {
+        active = false;
+        clearInterval(id);
+      };
+    }, [url, interval]);
+
+    const stickerProps = stickerPropsForStatus(status);
+
+    return (
+      <Sticker
+        ref={ref}
+        className={cn(className)}
+        {...stickerProps}
+        {...props}
+      >
+        <span
+          className="inline-block size-2 shrink-0 rounded-full bg-current"
+          aria-hidden="true"
+        />
+        <ButtonText>{label}</ButtonText>
+      </Sticker>
+    );
+  },
+);
+ServiceStatus.displayName = "ServiceStatus";
+
+export { ServiceStatus };
