+import { useEffect, useState } from "react";
+import type { Meta, StoryObj } from "@storybook/react-vite";
+import { ServiceStatus } from "./ServiceStatus";
+import { ServiceStatusState } from "./constants";
+
+/* ---------------------------------------------------------------------------
+ * Mock handler — intercepts fetch to a fake URL so stories work without a real
+ * endpoint.
+ * ----------------------------------------------------------------------- */
+const MOCK_URL = "https://status.example.com/api/status";
+
+const meta = {
+  title: "Status/ServiceStatus",
+  component: ServiceStatus,
+  parameters: { layout: "centered" },
+  tags: ["autodocs"],
+  args: { url: MOCK_URL, label: "Service", interval: 60_000 },
+} satisfies Meta<typeof ServiceStatus>;
+
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+function useMockFetch(state: ServiceStatusState) {
+  useEffect(() => {
+    const original = window.fetch;
+    window.fetch = async (input, init) => {
+      if (typeof input === "string" && input === MOCK_URL) {
+        return new Response(JSON.stringify({ status: state }), {
+          status: 200,
+          headers: { "Content-Type": "application/json" },
+        });
+      }
+      return original(input, init);
+    };
+    return () => {
+      window.fetch = original;
+    };
+  }, [state]);
+}
+
+/* --- Static states ------------------------------------------------------ */
+
+export const Operational: Story = {
+  render: function OperationalStory() {
+    useMockFetch(ServiceStatusState.operational);
+    return (
+      <ServiceStatus
+        url={MOCK_URL}
+        label="API Gateway"
+        interval={60_000}
+      />
+    );
+  },
+};
+
+export const Degraded: Story = {
+  render: function DegradedStory() {
+    useMockFetch(ServiceStatusState.degraded);
+    return (
+      <ServiceStatus
+        url={MOCK_URL}
+        label="Search Index"
+        interval={60_000}
+      />
+    );
+  },
+};
+
+export const Down: Story = {
+  render: function DownStory() {
+    useMockFetch(ServiceStatusState.down);
+    return (
+      <ServiceStatus
+        url={MOCK_URL}
+        label="Payment Service"
+        interval={60_000}
+      />
+    );
+  },
+};
+
+export const Unknown: Story = {
+  render: function UnknownStory() {
+    useMockFetch(ServiceStatusState.unknown);
+    return (
+      <ServiceStatus
+        url={MOCK_URL}
+        label="Telemetry"
+        interval={60_000}
+      />
+    );
+  },
+};
+
+/* --- Live cycling demo -------------------------------------------------- */
+
+const CYCLE: ServiceStatusState[] = [
+  ServiceStatusState.operational,
+  ServiceStatusState.degraded,
+  ServiceStatusState.down,
+  ServiceStatusState.unknown,
+];
+
+export const LiveCycle: Story = {
+  render: function LiveCycleStory() {
+    const [index, setIndex] = useState(0);
+    const state = CYCLE[index];
+
+    useMockFetch(state);
+
+    useEffect(() => {
+      const id = setInterval(
+        () => setIndex((i) => (i + 1) % CYCLE.length),
+        3000,
+      );
+      return () => clearInterval(id);
+    }, []);
+
+    return (
+      <ServiceStatus
+        url={MOCK_URL}
+        label="All Services"
+        interval={1000}
+      />
+    );
+  },
+};
+
+/* --- Dashboard row ------------------------------------------------------ */
+
+export const DashboardRow: Story = {
+  render: function DashboardRowStory() {
+    useMockFetch(ServiceStatusState.operational);
+    return (
+      <div className="flex flex-wrap items-center gap-rg">
+        <ServiceStatus url={MOCK_URL} label="API" interval={60_000} />
+        <ServiceStatus url={MOCK_URL} label="Auth" interval={60_000} />
+        <ServiceStatus url={MOCK_URL} label="CDN" interval={60_000} />
+      </div>
+    );
+  },
+};
