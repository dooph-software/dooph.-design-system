@@ -0,0 +1,15 @@
+// Server-safe constants — no client APIs, intentionally NO "use client" directive
+// so these dot-accessible enums can be read from React Server Components.
+
+/**
+ * The three states a status endpoint can return, plus `unknown` for the initial
+ * fetch and network errors.
+ */
+export const ServiceStatusState = {
+  operational: "operational",
+  degraded: "degraded",
+  down: "down",
+  unknown: "unknown",
+} as const;
+export type ServiceStatusState =
+  (typeof ServiceStatusState)[keyof typeof ServiceStatusState];
