+"use client";
+
+import { Button, ButtonVariant, ButtonSize } from "@dooph-software/design-system";
+
+declare global {
+  interface Window {
+    Intercom: (command: string) => void;
+  }
+}
+
+export function TalkToSalesButton() {
+  return (
+    <Button
+      variant={ButtonVariant.secondary}
+      size={ButtonSize.big}
+      onClick={() => window.Intercom("show")}
+    >
+      Talk to sales
+    </Button>
+  );
+}
