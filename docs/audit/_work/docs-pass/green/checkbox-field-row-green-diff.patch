+import { useState } from "react";
+import type { Meta, StoryObj } from "@storybook/react-vite";
+import { CheckboxField } from "./CheckboxField";
+import {
+  CheckboxChecked,
+  CheckboxVariant,
+  type CheckboxChecked as CheckboxCheckedValue,
+} from "../Checkbox/constants";
+
+const meta = {
+  title: "Inputs/CheckboxField",
+  component: CheckboxField,
+  parameters: { layout: "centered" },
+  tags: ["autodocs"],
+  argTypes: {
+    variant: {
+      control: "select",
+      options: Object.values(CheckboxVariant),
+    },
+  },
+} satisfies Meta<typeof CheckboxField>;
+
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+export const Default: Story = {
+  args: {
+    label: "Enable notifications",
+  },
+};
+
+export const WithHint: Story = {
+  args: {
+    label: "Enable notifications",
+    hint: "You will receive an email when something important happens.",
+  },
+};
+
+export const Checked: Story = {
+  args: {
+    label: "Accept terms and conditions",
+    hint: "By checking this box you agree to our terms of service.",
+    defaultChecked: true,
+  },
+};
+
+export const Primary: Story = {
+  args: {
+    label: "Remember me",
+    variant: CheckboxVariant.primary,
+    defaultChecked: true,
+  },
+};
+
+export const Disabled: Story = {
+  args: {
+    label: "This option is unavailable",
+    hint: "Contact support for access.",
+    disabled: true,
+  },
+};
+
+export const DisabledChecked: Story = {
+  args: {
+    label: "Required setting",
+    hint: "This setting cannot be changed.",
+    disabled: true,
+    checked: CheckboxChecked.checked,
+  },
+};
+
+export const Controlled: Story = {
+  args: {
+    label: "Notifications off",
+  },
+  render: function ControlledStory() {
+    const [checked, setChecked] = useState<CheckboxCheckedValue>(
+      CheckboxChecked.unchecked,
+    );
+
+    return (
+      <CheckboxField
+        label={
+          checked === CheckboxChecked.checked
+            ? "Notifications on"
+            : "Notifications off"
+        }
+        hint="Toggle to change your notification preference."
+        checked={checked}
+        onCheckedChange={setChecked}
+      />
+    );
+  },
+};
+
+export const AllVariants: Story = {
