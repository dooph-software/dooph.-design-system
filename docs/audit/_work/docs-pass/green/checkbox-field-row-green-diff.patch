+  },
+  render: () => (
+    <div className="flex flex-col gap-xl">
+      {Object.values(CheckboxVariant).map((variant) => (
+        <CheckboxField
+          key={variant}
+          variant={variant}
+          defaultChecked
+          label={`${variant} variant`}
+          hint={`This field uses the ${variant} checkbox fill.`}
+        />
+      ))}
+    </div>
+  ),
+};
