+import type { Meta, StoryObj } from "@storybook/react-vite";
+import { useState } from "react";
+import { BodyText, LabelText } from "../Text";
+import { Collapsible, CollapsibleContent, CollapsibleTrigger } from "./Collapsible";
+
+const meta = {
+  title: "Bits & Pieces/Collapsible",
+  component: Collapsible,
+  parameters: { layout: "centered" },
+  tags: ["autodocs"],
+} satisfies Meta<typeof Collapsible>;
+
+export default meta;
+type Story = StoryObj<typeof meta>;
+
+/** The default collapsed state with a single content block. */
+export const Default: Story = {
+  render: () => (
+    <div style={{ width: 320 }}>
+      <Collapsible>
+        <CollapsibleTrigger label="More details" />
+        <CollapsibleContent>
+          <div className="px-rg py-sm">
+            <BodyText>
+              This content is revealed when the trigger is clicked. The panel
+              animates open and closed smoothly.
+            </BodyText>
+          </div>
+        </CollapsibleContent>
+      </Collapsible>
+    </div>
+  ),
+};
+
+/** Starts open via the `defaultOpen` prop. */
+export const DefaultOpen: Story = {
+  render: () => (
+    <div style={{ width: 320 }}>
+      <Collapsible defaultOpen>
+        <CollapsibleTrigger label="Project settings" />
+        <CollapsibleContent>
+          <div className="px-rg py-sm">
+            <BodyText>
+              The collapsible starts open when defaultOpen is set. Click the
+              trigger to close it.
+            </BodyText>
+          </div>
+        </CollapsibleContent>
+      </Collapsible>
+    </div>
+  ),
+};
+
+/** Disabled state: the trigger is not interactive. */
+export const Disabled: Story = {
+  render: () => (
+    <div style={{ width: 320 }}>
+      <Collapsible disabled>
+        <CollapsibleTrigger label="Unavailable section" />
+        <CollapsibleContent>
+          <div className="px-rg py-sm">
+            <BodyText>This content is not reachable.</BodyText>
+          </div>
+        </CollapsibleContent>
+      </Collapsible>
+    </div>
+  ),
+};
+
+/** Controlled open/close via `open` and `onOpenChange`. */
+export const Controlled: Story = {
+  render: function ControlledStory() {
+    const [open, setOpen] = useState(false);
+    return (
+      <div style={{ width: 320 }} className="flex flex-col gap-rg">
+        <Collapsible open={open} onOpenChange={setOpen}>
+          <CollapsibleTrigger label="Controlled section" />
+          <CollapsibleContent>
+            <div className="px-rg py-sm">
+              <BodyText>
+                This panel is controlled externally. Toggle it with the trigger
+                or any other mechanism that calls onOpenChange.
+              </BodyText>
+            </div>
+          </CollapsibleContent>
+        </Collapsible>
+        <LabelText>open: {JSON.stringify(open)}</LabelText>
+      </div>
+    );
+  },
+};
+
+/** Multiple collapsibles stacked vertically. */
+export const Multiple: Story = {
+  render: () => (
+    <div style={{ width: 320 }} className="flex flex-col">
+      {["General", "Appearance", "Advanced"].map((section) => (
+        <Collapsible key={section}>
+          <CollapsibleTrigger label={section} />
+          <CollapsibleContent>
+            <div className="px-rg py-sm">
+              <BodyText>Content for the {section} section.</BodyText>
+            </div>
+          </CollapsibleContent>
+        </Collapsible>
+      ))}
+    </div>
+  ),
+};
