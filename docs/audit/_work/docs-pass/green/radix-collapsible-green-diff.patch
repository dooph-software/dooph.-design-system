@@ -0,0 +1,81 @@
+import * as CollapsiblePrimitive from "@radix-ui/react-collapsible";
+import {
+  forwardRef,
+  type ComponentPropsWithoutRef,
+  type ComponentRef,
+} from "react";
+import { cn } from "../../utils/cn";
+import { ChevronDownIcon, IconSize } from "../Icons";
+import { LabelText } from "../Text";
+
+/* ── Root (thin pass-through) ─────────────────────────────────────── */
+
+const Collapsible = CollapsiblePrimitive.Root;
+
+/* ── Trigger ──────────────────────────────────────────────────────── */
+
+export interface CollapsibleTriggerProps
+  extends ComponentPropsWithoutRef<typeof CollapsiblePrimitive.Trigger> {
+  /** Text label shown beside the chevron. */
+  label: string;
+}
+
+/**
+ * A button that toggles the collapsible open and closed. Shows a label
+ * and a chevron that rotates 180 degrees when open.
+ */
+const CollapsibleTrigger = forwardRef<
+  ComponentRef<typeof CollapsiblePrimitive.Trigger>,
+  CollapsibleTriggerProps
+>(({ label, className, children, ...props }, ref) => (
+  <CollapsiblePrimitive.Trigger
+    ref={ref}
+    className={cn(
+      "group flex w-full cursor-pointer items-center gap-rg rounded-tight px-rg py-sm",
+      "bg-transparent border-none",
+      "ds-motion-state ds-focus-visible-ring",
+      "hover:bg-secondary",
+      className,
+    )}
+    {...props}
+  >
+    <ChevronDownIcon
+      size={IconSize.sm}
+      className={cn(
+        "shrink-0 ds-motion-state",
+        "group-data-[state=open]:rotate-180",
+      )}
+    />
+    <LabelText as="span" className="select-none">
+      {label}
+    </LabelText>
+    {children}
+  </CollapsiblePrimitive.Trigger>
+));
+CollapsibleTrigger.displayName = "CollapsibleTrigger";
+
+/* ── Content ──────────────────────────────────────────────────────── */
+
+export type CollapsibleContentProps = ComponentPropsWithoutRef<
+  typeof CollapsiblePrimitive.Content
+>;
+
+/**
+ * The panel that expands and collapses. Animates height via
+ * a grid-rows 0fr / 1fr transition so it measures no explicit height.
+ */
+const CollapsibleContent = forwardRef<
+  ComponentRef<typeof CollapsiblePrimitive.Content>,
+  CollapsibleContentProps
+>(({ className, children, ...props }, ref) => (
+  <CollapsiblePrimitive.Content
+    ref={ref}
+    className={cn("ds-collapsible-content", className)}
+    {...props}
+  >
+    <div className="min-h-0 overflow-hidden">{children}</div>
+  </CollapsiblePrimitive.Content>
+));
+CollapsibleContent.displayName = "CollapsibleContent";
+
+export { Collapsible, CollapsibleContent, CollapsibleTrigger };
