+import {
+  forwardRef,
+  type ComponentRef,
+  type ReactNode,
+} from "react";
+import * as CheckboxPrimitive from "@radix-ui/react-checkbox";
+import { cn } from "../../utils/cn";
+import { Checkbox, type CheckboxProps } from "../Checkbox";
+import { BodyText, LabelText } from "../Text";
+
+export interface CheckboxFieldProps extends CheckboxProps {
+  /** Primary text rendered beside the checkbox. */
+  label: ReactNode;
+  /** Secondary line rendered below the label, in the body role at secondary colour. */
+  hint?: ReactNode;
+}
+
+/**
+ * A checkbox with a label beside it and an optional hint line below the label.
+ *
+ * `className` lands on the root `<label>`; `ref` and every other prop land on
+ * the inner `Checkbox`.
+ */
+const CheckboxField = forwardRef<
+  ComponentRef<typeof CheckboxPrimitive.Root>,
+  CheckboxFieldProps
+>(({ label, hint, className, ...checkboxProps }, ref) => (
+  <LabelText
+    as="label"
+    className={cn("inline-flex items-start gap-sm", className)}
+  >
+    <Checkbox ref={ref} {...checkboxProps} />
+    <span className="flex flex-col gap-xxs">
+      <span>{label}</span>
+      {hint != null && (
+        <BodyText as="span" className="text-text-secondary">
+          {hint}
+        </BodyText>
+      )}
+    </span>
+  </LabelText>
+));
+CheckboxField.displayName = "CheckboxField";
+
+export { CheckboxField };
