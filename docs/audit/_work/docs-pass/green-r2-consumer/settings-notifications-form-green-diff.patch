index 0000000..82a5b37
--- /dev/null
+++ b/app/settings/notifications/notifications-form.tsx
@@ -0,0 +1,156 @@
+"use client";
+
+import { useState } from "react";
+import {
+  BodyText,
+  Button,
+  ButtonVariant,
+  Checkbox,
+  Input,
+  LabelText,
+  SubheadingText,
+} from "@dooph-software/design-system";
+import type { NotificationSettings } from "@/lib/settings";
+
+const NOTIFICATION_TYPES = [
+  {
+    key: "mentions" as const,
+    label: "Mentions",
+    description: "Someone mentions you in a comment or document.",
+  },
+  {
+    key: "replies" as const,
+    label: "Replies",
+    description: "Someone replies to a thread you're part of.",
+  },
+  {
+    key: "productUpdates" as const,
+    label: "Product updates",
+    description: "New features, improvements and release notes.",
+  },
+];
+
+export function NotificationsForm({
+  initial,
+}: {
+  initial: NotificationSettings;
+}) {
+  const [email, setEmail] = useState(initial.email);
+  const [weeklyDigest, setWeeklyDigest] = useState(initial.weeklyDigest);
+  const [mentions, setMentions] = useState(initial.mentions);
+  const [replies, setReplies] = useState(initial.replies);
+  const [productUpdates, setProductUpdates] = useState(
+    initial.productUpdates,
+  );
+  const [saving, setSaving] = useState(false);
+
+  const checkboxState: Record<
+    (typeof NOTIFICATION_TYPES)[number]["key"],
+    [boolean, (v: boolean) => void]
+  > = {
+    mentions: [mentions, setMentions],
+    replies: [replies, setReplies],
+    productUpdates: [productUpdates, setProductUpdates],
+  };
+
+  async function save() {
+    setSaving(true);
+    await fetch("/api/settings/notifications", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({
+        email,
+        weeklyDigest,
+        mentions,
+        replies,
+        productUpdates,
+      }),
+    });
+    setSaving(false);
+  }
+
+  return (
+    <form
+      className="flex flex-col gap-xl"
+      onSubmit={(e) => {
+        e.preventDefault();
+        void save();
+      }}
+    >
+      {/* Email */}
+      <div className="flex flex-col gap-xs">
+        <LabelText as="label" htmlFor="notif-email">
+          Email address
+        </LabelText>
+        <Input
+          id="notif-email"
+          type="email"
+          value={email}
+          onValueChange={setEmail}
+        />
+      </div>
+
+      {/* Weekly digest */}
+      <div className="flex flex-col gap-sm">
+        <SubheadingText as="h2">Digest</SubheadingText>
+        <div className="flex items-center gap-sm">
+          <Checkbox
+            id="notif-weekly-digest"
+            checked={weeklyDigest}
+            onCheckedChange={(v) => setWeeklyDigest(v === true)}
+          />
+          <LabelText as="label" htmlFor="notif-weekly-digest">
+            Weekly digest
+          </LabelText>
+        </div>
+        <BodyText as="p" className="text-text-secondary">
+          A summary of activity you missed, delivered every Monday.
+        </BodyText>
+      </div>
+
+      {/* Notification types */}
+      <div className="flex flex-col gap-sm">
+        <SubheadingText as="h2">Notification types</SubheadingText>
+        <div className="flex flex-col gap-md">
+          {NOTIFICATION_TYPES.map(({ key, label, description }) => {
+            const [checked, setChecked] = checkboxState[key];
+            return (
+              <div key={key} className="flex items-start gap-sm">
+                <Checkbox
+                  id={`notif-${key}`}
+                  checked={checked}
+                  onCheckedChange={(v) => setChecked(v === true)}
+                  className="mt-xxs"
+                />
+                <div className="flex flex-col">
+                  <LabelText as="label" htmlFor={`notif-${key}`}>
+                    {label}
+                  </LabelText>
+                  <BodyText as="p" className="text-text-secondary">
+                    {description}
+                  </BodyText>
+                </div>
+              </div>
+            );
+          })}
+        </div>
+      </div>
+
+      {/* Actions */}
+      <div className="flex gap-sm">
+        <Button type="submit" variant={ButtonVariant.prominent} disabled={saving}>
+          {saving ? "Saving…" : "Save"}
+        </Button>
+        <Button type="reset" onClick={() => {
+          setEmail(initial.email);
+          setWeeklyDigest(initial.weeklyDigest);
+          setMentions(initial.mentions);
+          setReplies(initial.replies);
+          setProductUpdates(initial.productUpdates);
+        }}>
+          Cancel
+        </Button>
+      </div>
+    </form>
+  );
+}
diff --git a/app/settings/notifications/page.tsx b/app/settings/notifications/page.tsx
