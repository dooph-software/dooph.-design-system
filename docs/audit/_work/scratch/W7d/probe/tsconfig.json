{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020","DOM","DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "moduleResolution": "bundler", "module": "ESNext", "isolatedModules": true,
    "skipLibCheck": true, "noUnusedLocals": true, "noUnusedParameters": true, "noEmit": true
  },
  "include": ["*.tsx"]
}
